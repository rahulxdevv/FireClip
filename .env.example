# ─────────────────────────────────────────────────────────────────────────────
# FireClip configuration
# Copy to .env and fill in. Docker Compose reads this file automatically.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED: 32+ random bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Public URLs (used for OAuth callbacks, CORS and cookie hardening)
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
# Web and API ports. Docker Compose binds the containers to these numbers too,
# so the host port, the container port and the port you point a proxy at are all
# the same value. Change them when 3000/8000 are taken on the host, and update
# FRONTEND_URL / BACKEND_PUBLIC_URL above to match.
WEB_PORT=3000
API_PORT=8000
API_HOST=127.0.0.1
# debug | info | warning | error
LOG_LEVEL=INFO
# Set true when serving over HTTPS
COOKIE_SECURE=false

# Database (Compose spawns PostgreSQL; only change if using an external server)
POSTGRES_USER=fireclip
POSTGRES_PASSWORD=fireclip
POSTGRES_DB=fireclip
# Non-Docker/local URL:
# DATABASE_URL=sqlite:///./data/fireclip.db

# Queue: Docker uses Redis + ARQ. Locally leave unset for the inline runner.
# REDIS_URL=redis://localhost:6379/0
# JOB_RUNNER=inline
# Lower these on small hosts; raise only with enough CPU and RAM.
WORKER_CONCURRENCY=2
RENDER_CONCURRENCY=1

# Sign-ups
ALLOW_REGISTRATION=true
# Require a confirmed email before the account can sign in. Leave false for a
# frictionless self-hosted install; set true when SMTP is configured.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_HOURS=48
PASSWORD_RESET_MINUTES=60
INVITE_EXPIRY_DAYS=7

# ── Transactional email (optional) ───────────────────────────────────────────
# Without SMTP, verification/reset/invite links are written to the backend log
# in debug mode. Nothing claims an email was delivered when it was not.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
MAIL_FROM=no-reply@fireclip.local
MAIL_FROM_NAME=FireClip

# ── Billing (optional, Stripe) ───────────────────────────────────────────────
# Leave blank to run entirely without payments. Plan limits still apply.
# Dashboard: Developers → Webhooks → endpoint /api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_STUDIO_MONTH=
STRIPE_PRICE_STUDIO_YEAR=
STRIPE_PRICE_AGENCY_MONTH=
STRIPE_PRICE_AGENCY_YEAR=

# ── Transcription ────────────────────────────────────────────────────────────
# faster_whisper (local, included in Docker) | whisper | openai | auto
TRANSCRIPTION_ENGINE=faster_whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Lower beam size and worker count on low-power machines for faster runs.
WHISPER_BEAM_SIZE=5
WHISPER_CPU_THREADS=0
# off | estimate (pause heuristic) | pyannote (needs the extras + HF token)
DIARIZATION_MODE=off
# Only enable in tests; mock transcripts are clearly labelled everywhere.
ALLOW_MOCK_TRANSCRIPTION=false

# ── AI providers ─────────────────────────────────────────────────────────────
# heuristic | openai | anthropic | gemini | ollama | auto (never picks Ollama)
AI_PROVIDER=heuristic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Campaign discovery (optional) ────────────────────────────────────────────
# JSON feed for the Campaigns page. Leave empty to use manual campaigns only.
# A list or {"campaigns": [...]}; see docs/guides.md for fields.
CAMPAIGN_FEED_URL=
CAMPAIGN_FEED_TOKEN=
CAMPAIGN_FEED_LABEL=Content Rewards

# ── Social publishing (optional) ─────────────────────────────────────────────
# Callback: {BACKEND_PUBLIC_URL}/api/publishing/callback/<platform>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Storage (optional S3) ────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, required for Instagram Reels publishing
# MEDIA_PUBLIC_BASE_URL=

# ── Media / limits ───────────────────────────────────────────────────────────
MAX_UPLOAD_MB=4096
PLAN_CLIP_LIMIT=500
PLAN_RENDER_MINUTES=600
# Higher CRF = smaller/faster, lower quality. x264 presets: ultrafast..veryslow
RENDER_CRF=20
RENDER_X264_PRESET=veryfast
# Optional hardware encoding: nvenc
HWACCEL=
